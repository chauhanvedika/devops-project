DB_USER=eimsuser
DB_PASSWORD=change_me_to_a_long_random_value

# First admin account, created by the migrate step only when no users exist (12-72 chars).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_long_random_value

# true = load a few demo employees/items on an empty database
SEED_DEMO=true

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_never_commit_real_value

# Optional: change host port
# FRONTEND_HOST_PORT=3000
